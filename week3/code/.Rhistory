model <- lm(Predator.mass ~ Prey.mass, data = subdata)
s <- summary(model)
results <- rbind(results, data.frame(
FeedingType = ft,
Predator.lifestage = stage,
Slope = coef(model)[2],
Intercept = coef(model)[1],
R2 = s$r.squared,
F_stat = s$fstatistic[1],
p_value = pf(s$fstatistic[1],
s$fstatistic[2],
s$fstatistic[3],
lower.tail = FALSE)
))
}
}
}
# ---- Save regression results ----
if (!dir.exists("../results")) dir.create("../results", recursive = TRUE)
write.csv(results, "../results/PP_Regress_Results.csv", row.names = FALSE)
cat("Saved: ../results/PP_Regress_Results.csv\n")
