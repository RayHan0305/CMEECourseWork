set.seed(42)
# ---- Load data ----
load("../data/KeyWestAnnualMeanTemperature.RData")
# Inspect the dataset
ls()
class(ats)
head(ats)
plot(ats)
# ---- Compute observed correlation ----
r_obs <- cor(ats$Year, ats$Temperature)
cat("Observed correlation:", r_obs, "\n")
# ---- Permutation test using sample() ----
n_perm <- 10000
r_perm <- numeric(n_perm)   # Preallocate vector (faster, as in sample.R)
for (i in 1:n_perm) {
shuffled_temp <- sample(ats$Temperature, replace = FALSE)
r_perm[i] <- cor(ats$Year, shuffled_temp)
}
# Compute one-sided p-value (how many permuted correlations >= observed)
p_value <- sum(r_perm >= r_obs) / n_perm
cat("Permutation test p-value:", p_value, "\n")
# ---- Visualize ----
hist(r_perm, breaks = 40, main = "Permutation Test for Key West Temperature Trend",
xlab = "Correlation Coefficient", col = "lightblue", border = "white")
abline(v = r_obs, col = "red", lwd = 2)
legend("topright", legend = sprintf("Observed r = %.3f", r_obs), col = "red", lwd = 2)
# ---- Optional: Plot trend ----
plot(ats$Year, ats$Temperature, pch = 20,
main = "Key West Annual Mean Temperature (1900–2000)",
xlab = "Year", ylab = "Temperature (°C)")
abline(lm(Temperature ~ Year, data = ats), col = "red", lwd = 2)
rm(list=ls())
